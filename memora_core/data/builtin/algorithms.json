[
  {
    "id": "bm25",
    "name": "BM25 相关性打分",
    "category": "retrieval",
    "summary": "默认检索的关键词通道（retrieval._channel_bm25_lexical）：Python 侧按文字类别切分——中文/假名/谚文切重叠二元组并以单字回退，英文按词并做复数归一与前缀匹配，查询侧去虚词——在候选池内算 BM25，列权 title 3 / summary 1.5 / body 1。FTS5 unicode61 的 bm25() 作为可选引擎保留（BM25_ENGINE='fts5'），它不切中文。",
    "formula": "score(q,d)=Σ w_t·IDF(t)·(f(t,d)·(k1+1))/(f(t,d)+k1·(1-b+b·|d|/avgdl)), k1=1.2, b=0.75, IDF=ln(1+(N-df+0.5)/(df+0.5))",
    "reference": "Robertson & Zaragoza 2009",
    "offline": 1,
    "runnable": 1
  },
