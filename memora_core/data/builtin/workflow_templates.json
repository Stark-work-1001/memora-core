    "inputs": {
      "since": "上次水位"
    },
    "nodes": [
      {
        "id": "diff",
        "name": "变更检测",
        "kind": "input",
        "role": null,
        "params": {
          "by": [
            "updated_at",
            "hash"
          ]
        }
      },
      {
        "id": "reindex_fts",
