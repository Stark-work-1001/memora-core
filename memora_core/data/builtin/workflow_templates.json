[
  {
    "id": "session-distill",
    "name": "智能体会话沉淀",
    "category": "ingest",
    "version": 3,
    "description": "把一次智能体会话（任务描述、分析、工具调用、结论）提炼成候选记忆，经判重、来源核验后写入为**候选**（待人工审核），并写入按日期的 Markdown。",
    "trigger": {
      "kind": "session-end",
      "sources": [
        "agent_session"
      ]
    },
    "inputs": {
      "session": "会话对象",
      "scope": "作用域路径",
      "agent": "智能体 id"
    },
    "nodes": [
      {
        "id": "capture",
        "name": "接收会话",
        "kind": "input",
        "role": null,
        "params": {}
      },
      {
        "id": "normalize",
        "name": "归一化与分片",
        "kind": "transform",
        "role": null,
        "params": {
          "chunk_tokens": 900,
          "overlap": 120
        }
      },
      {
        "id": "extract",
        "name": "候选记忆提炼",
        "kind": "extract",
        "role": "extractor",
        "params": {
          "quote_required": true
        }
      },
      {
        "id": "classify",
        "name": "类型与领域分类",
        "kind": "classify",
        "role": "judge",
        "params": {
          "kinds": [
            "fact",
            "knowledge",
            "decision",
            "preference",
            "procedure",
            "experience",
            "task",
            "tool"
          ]
        }
      },
      {
        "id": "dedup_recall",
        "name": "相似旧记忆召回",
        "kind": "retrieve",
        "role": "embedding",
        "params": {
          "top_k": 12,
          "min_score": 0.55
        }
      },
      {
        "id": "dedup_judge",
        "name": "重复/冲突判定",
        "kind": "judge",
        "role": "judge",
        "params": {
          "actions": [
            "add",
            "update",
            "supersede",
            "merge",
            "link",
            "noop",
            "ask"
          ]
        }
      },
      {
        "id": "verify_source",
        "name": "来源核验",
        "kind": "verify",
        "role": null,
        "params": {
          "require_quote": true,
          "reject_agent_only_claims": true
        }
      },
      {
        "id": "persist",
        "name": "沉淀入 SQLite（候选）",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "memory",
          "status": "candidate",
          "from": "classify"
        }
      },
      {
        "id": "mirror",
        "name": "写入日期 Markdown",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "markdown",
          "target": "markdown",
          "layout": "daily"
        }
      },
      {
        "id": "index",
        "name": "增量索引",
        "kind": "index",
        "role": "embedding",
        "params": {
          "incremental": true
        }
      }
    ],
    "edges": [
      {
        "from": "capture",
        "to": "normalize",
        "when": "always"
      },
      {
        "from": "normalize",
        "to": "extract",
        "when": "always"
      },
      {
        "from": "extract",
        "to": "classify",
        "when": "always"
      },
      {
        "from": "classify",
        "to": "dedup_recall",
        "when": "always"
      },
      {
        "from": "dedup_recall",
        "to": "dedup_judge",
        "when": "always"
      },
      {
        "from": "dedup_judge",
        "to": "verify_source",
        "when": "always"
      },
      {
        "from": "verify_source",
        "to": "persist",
        "when": "always"
      },
      {
        "from": "persist",
        "to": "mirror",
        "when": "always"
      },
      {
        "from": "mirror",
        "to": "index",
        "when": "always"
      }
    ],
    "fallbacks": {
      "extract": "rule-extract",
      "classify": "rule-classify",
      "dedup_judge": "score-threshold",
      "verify_source": "quote-check-only"
    }
  },
  {
    "id": "study-notes-review",
    "name": "学习笔记与复习",
    "category": "learn",
    "version": 3,
    "description": "把笔记拆成定义/定理/特征/公式/推导/例题六层，生成复习卡片与到期计划（SM-2），并按艾宾浩斯式间隔提醒复习。",
    "trigger": {
      "kind": "manual",
      "sources": [
        "document",
        "memory"
      ]
    },
    "inputs": {
      "text": "笔记正文或文档 id"
    },
    "nodes": [
      {
        "id": "ingest",
        "name": "读取笔记",
        "kind": "input",
        "role": null,
        "params": {}
      },
      {
        "id": "segment",
        "name": "结构化切分",
        "kind": "transform",
        "role": null,
        "params": {
          "headings": true,
          "math": true
        }
      },
      {
        "id": "didactic",
        "name": "教学分层抽取",
        "kind": "extract",
        "role": "extractor",
        "params": {
          "layers": [
            "definition",
            "theorem",
            "property",
            "formula",
            "derivation",
            "example"
          ]
        }
      },
      {
        "id": "formula_latex",
        "name": "公式转 LaTeX",
        "kind": "transform",
        "role": "extractor",
        "params": {
          "output": "katex"
        }
      },
      {
        "id": "link_entities",
        "name": "概念实体与先修关系",
        "kind": "graph",
        "role": null,
        "params": {
          "rels": [
            "prerequisite",
            "hypernym",
            "part_of"
          ]
        }
      },
      {
        "id": "cards",
        "name": "生成复习卡",
        "kind": "generate",
        "role": "chat",
        "params": {
          "types": [
            "blank"
          ]
        }
      },
      {
        "id": "schedule",
        "name": "计算到期时间",
        "kind": "schedule",
        "role": null,
        "params": {
          "algorithm": "sm2",
          "ease": 2.5
        }
      },
      {
        "id": "persist",
        "name": "落库（带复习到期时间）",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "memory",
          "kind": "knowledge",
          "review_due_from": "schedule",
          "from": "didactic"
        }
      }
    ],
    "edges": [
      {
        "from": "ingest",
        "to": "segment",
        "when": "always"
      },
      {
        "from": "segment",
        "to": "didactic",
        "when": "always"
      },
      {
        "from": "didactic",
        "to": "formula_latex",
        "when": "always"
      },
      {
        "from": "formula_latex",
        "to": "link_entities",
        "when": "always"
      },
      {
        "from": "link_entities",
        "to": "cards",
        "when": "always"
      },
      {
        "from": "cards",
        "to": "schedule",
        "when": "always"
      },
      {
        "from": "schedule",
        "to": "persist",
        "when": "always"
      }
    ],
    "fallbacks": {
      "didactic": "heading-based-split",
      "formula_latex": "keep-source-tex",
      "cards": "cloze-from-text"
    }
  },
  {
    "id": "doc-knowledgeize",
    "name": "外部文档知识化",
    "category": "ingest",
    "version": 3,
    "description": "吸收 Markdown/PDF/TXT/HTML/JSONL 外部文档：切块、摘要、抽实体、建关系、写入文档库并纳入检索，保留原始出处哈希。",
    "trigger": {
      "kind": "manual",
      "sources": [
        "file",
        "folder"
      ]
    },
    "inputs": {
      "path": "文件或目录",
      "scope": "目标作用域"
    },
    "nodes": [
      {
        "id": "read",
        "name": "读取文档",
        "kind": "input",
        "role": null,
        "params": {
          "formats": [
            "md",
            "txt",
            "pdf",
            "html",
            "json",
            "jsonl"
          ]
        }
      },
      {
        "id": "dedupe_file",
        "name": "文档级去重",
        "kind": "verify",
        "role": null,
        "params": {
          "by": "content_hash"
        }
      },
      {
        "id": "chunk",
        "name": "语义切块",
        "kind": "transform",
        "role": null,
        "params": {
          "tokens": 900,
          "overlap": 120,
          "keep_headings": true
        }
      },
      {
        "id": "persist",
        "name": "写入文档库",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "document",
          "mirror": "markdown"
        }
      },
      {
        "id": "summarize",
        "name": "分块摘要",
        "kind": "generate",
        "role": "chat",
        "params": {
          "max_tokens": 180
        }
      },
      {
        "id": "entities",
        "name": "实体抽取",
        "kind": "extract",
        "role": "extractor",
        "params": {
          "kinds": [
            "concept",
            "person",
            "project",
            "tool",
            "term"
          ]
        }
      },
      {
        "id": "relations",
        "name": "关系抽取",
        "kind": "graph",
        "role": null,
        "params": {
          "rels": [
            "hypernym",
            "hyponym",
            "part_of",
            "causes",
            "supports"
          ]
        }
      },
      {
        "id": "embed",
        "name": "向量化",
        "kind": "embed",
        "role": "embedding",
        "params": {
          "owner_kind": "chunk",
          "from": "persist"
        }
      },
      {
        "id": "index_fts",
        "name": "全文索引",
        "kind": "index",
        "role": null,
        "params": {
          "engine": "fts5",
          "tokenize": "unicode61"
        }
      }
    ],
    "edges": [
      {
        "from": "read",
        "to": "dedupe_file",
        "when": "always"
      },
      {
        "from": "dedupe_file",
        "to": "chunk",
        "when": "always"
      },
      {
        "from": "chunk",
        "to": "persist",
        "when": "always"
      },
      {
        "from": "persist",
        "to": "summarize",
        "when": "always"
      },
      {
        "from": "summarize",
        "to": "entities",
        "when": "always"
      },
      {
        "from": "entities",
        "to": "relations",
        "when": "always"
      },
      {
        "from": "relations",
        "to": "embed",
        "when": "always"
      },
      {
        "from": "embed",
        "to": "index_fts",
        "when": "always"
      }
    ],
    "fallbacks": {
      "summarize": "lead-sentences",
      "entities": "capitalized-noun-phrase",
      "relations": "cooccurrence-window",
      "embed": "char-ngram-hash"
    }
  },
  {
    "id": "hybrid-recall-rerank",
    "name": "混合召回与重排序",
    "category": "recall",
    "version": 3,
    "description": "BM25 + 向量 + 实体图三路召回，RRF 融合，cross-encoder 重排，MMR 去冗余，最后按 token 预算打包成上下文，附引用与降级标记。",
    "trigger": {
      "kind": "agent",
      "sources": [
        "query"
      ]
    },
    "inputs": {
      "query": "检索语句",
      "scope": "作用域",
      "budget": "token 预算"
    },
    "nodes": [
      {
        "id": "query_parse",
        "name": "查询解析",
        "kind": "transform",
        "role": null,
        "params": {
          "extract_filters": true
        }
      },
      {
        "id": "bm25",
        "name": "全文召回",
        "kind": "retrieve",
        "role": null,
        "params": {
          "engine": "fts5",
          "top_k": 40
        }
      },
      {
        "id": "vector",
        "name": "向量召回",
        "kind": "retrieve",
        "role": "embedding",
        "params": {
          "top_k": 40
        }
      },
      {
        "id": "graph",
        "name": "实体图扩展召回",
        "kind": "retrieve",
        "role": null,
        "params": {
          "engine": "graph",
          "hops": 1,
          "top_k": 20
        }
      },
      {
        "id": "fuse",
        "name": "RRF 融合",
        "kind": "fuse",
        "role": null,
        "params": {
          "algorithm": "rrf",
          "k": 60,
          "weights": {
            "bm25": 1.0,
            "vector": 1.0,
            "graph": 0.6
          }
        }
      },
      {
        "id": "rerank",
        "name": "精排",
        "kind": "rerank",
        "role": "reranker",
        "params": {
          "top_k": 20
        }
      },
      {
        "id": "mmr",
        "name": "去冗余",
        "kind": "fuse",
        "role": null,
        "params": {
          "algorithm": "mmr",
          "lambda_": 0.7
        }
      },
      {
        "id": "pack",
        "name": "预算打包",
        "kind": "transform",
        "role": null,
        "params": {
          "algorithm": "greedy-budget",
          "cite": true
        }
      }
    ],
    "edges": [
      {
        "from": "query_parse",
        "to": "bm25",
        "when": "always"
      },
      {
        "from": "query_parse",
        "to": "vector",
        "when": "always"
      },
      {
        "from": "query_parse",
        "to": "graph",
        "when": "always"
      },
      {
        "from": "bm25",
        "to": "fuse",
        "when": "always"
      },
      {
        "from": "vector",
        "to": "fuse",
        "when": "always"
      },
      {
        "from": "graph",
        "to": "fuse",
        "when": "always"
      },
      {
        "from": "fuse",
        "to": "rerank",
        "when": "always"
      },
      {
        "from": "rerank",
        "to": "mmr",
        "when": "always"
      },
      {
        "from": "mmr",
        "to": "pack",
        "when": "always"
      }
    ],
    "fallbacks": {
      "vector": "bm25-only",
      "graph": "skip",
      "rerank": "score-passthrough"
    }
  },
  {
    "id": "conflict-source-audit",
    "name": "冲突与来源审计",
    "category": "audit",
    "version": 3,
    "description": "扫描互斥记忆与低信任来源，按证据强度、时间、来源类型排序，产出审计报告与建议动作，人工裁决后写回。",
    "trigger": {
      "kind": "schedule",
      "cron": "0 3 * * *"
    },
    "inputs": {
      "scope": "作用域",
      "since": "时间窗"
    },
    "nodes": [
      {
        "id": "collect",
        "name": "收集候选对",
        "kind": "input",
        "role": null,
        "params": {
          "strategy": "entity-overlap + vector-near"
        }
      },
      {
        "id": "score_conflict",
        "name": "冲突打分",
        "kind": "fuse",
        "role": null,
        "params": {
          "algorithm": "conflict-score"
        }
      },
      {
        "id": "evidence_rank",
        "name": "证据强度排序",
        "kind": "judge",
        "role": "judge",
        "params": {
          "rubric": "source-trust"
        }
      },
      {
        "id": "report",
        "name": "生成审计报告",
        "kind": "generate",
        "role": "chat",
        "params": {
          "output": "markdown+json"
        }
      },
      {
        "id": "propose",
        "name": "建议动作",
        "kind": "decide",
        "role": null,
        "params": {
          "actions": [
            "supersede",
            "merge",
            "mark_stale",
            "ask_user"
          ]
        }
      },
      {
        "id": "persist",
        "name": "写入冲突表与报告文档",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "conflict",
          "min_score": 0.5
        }
      }
    ],
    "edges": [
      {
        "from": "collect",
        "to": "score_conflict",
        "when": "always"
      },
      {
        "from": "score_conflict",
        "to": "evidence_rank",
        "when": "always"
      },
      {
        "from": "evidence_rank",
        "to": "report",
        "when": "always"
      },
      {
        "from": "report",
        "to": "propose",
        "when": "always"
      },
      {
        "from": "propose",
        "to": "persist",
        "when": "always"
      }
    ],
    "fallbacks": {
      "evidence_rank": "trust-weight-order",
      "report": "template-report"
    }
  },
  {
    "id": "project-retro",
    "name": "项目决策与经验复盘",
    "category": "learn",
    "version": 3,
    "description": "从会话与提交记录中抽取决策（背景/选项/取舍/结果），沉淀为可复用的经验条目并关联工作区。",
    "trigger": {
      "kind": "manual",
      "sources": [
        "agent_session",
        "workspace"
      ]
    },
    "inputs": {
      "workspace": "工作区路径",
      "window": "时间窗"
    },
    "nodes": [
      {
        "id": "gather",
        "name": "汇集素材",
        "kind": "input",
        "role": null,
        "params": {
          "collect": "workspace-sessions"
        }
      },
      {
        "id": "decision_extract",
        "name": "决策抽取",
        "kind": "extract",
        "role": "extractor",
        "params": {
          "fields": [
            "context",
            "options",
            "choice",
            "rationale",
            "outcome",
            "reusable_lesson"
          ]
        }
      },
      {
        "id": "outcome_verify",
        "name": "结果核验",
        "kind": "verify",
        "role": null,
        "params": {
          "by": "tool_output_or_user_confirm"
        }
      },
      {
        "id": "lessons",
        "name": "经验条目化",
        "kind": "transform",
        "role": null,
        "params": {
          "kind": "experience"
        }
      },
      {
        "id": "link",
        "name": "关联工作区与任务",
        "kind": "graph",
        "role": null,
        "params": {
          "rels": [
            "derived_from",
            "supports"
          ]
        }
      },
      {
        "id": "persist",
        "name": "沉淀",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "memory",
          "kind": "experience",
          "from": "lessons"
        }
      }
    ],
    "edges": [
      {
        "from": "gather",
        "to": "decision_extract",
        "when": "always"
      },
      {
        "from": "decision_extract",
        "to": "outcome_verify",
        "when": "always"
      },
      {
        "from": "outcome_verify",
        "to": "lessons",
        "when": "always"
      },
      {
        "from": "lessons",
        "to": "link",
        "when": "always"
      },
      {
        "from": "link",
        "to": "persist",
        "when": "always"
      }
    ],
    "fallbacks": {
      "decision_extract": "keyword-time-slice"
    }
  },
  {
    "id": "detail-abstraction",
    "name": "细节与抽象线索",
    "category": "transform",
    "version": 3,
    "description": "把原始细节与抽象线索分离：细节保真留存，抽象生成可检索的 cue（线索），检索时线索命中细节，降低遗忘与错配。",
    "trigger": {
      "kind": "manual",
      "sources": [
        "memory",
        "document"
      ]
    },
    "inputs": {
      "items": "记忆或文档块列表"
    },
    "nodes": [
      {
        "id": "load",
        "name": "载入原始细节",
        "kind": "input",
        "role": null,
        "params": {}
      },
      {
        "id": "abstract",
        "name": "生成抽象线索",
        "kind": "generate",
        "role": "chat",
        "params": {
          "style": "cue-question"
        }
      },
      {
        "id": "keep_detail",
        "name": "细节原样留存",
        "kind": "transform",
        "role": null,
        "params": {}
      },
      {
        "id": "pair",
        "name": "线索-细节配对",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "link",
          "rel": "cue_of"
        }
      },
      {
        "id": "cues_index",
        "name": "线索索引",
        "kind": "index",
        "role": null,
        "params": {}
      }
    ],
    "edges": [
      {
        "from": "load",
        "to": "abstract",
        "when": "always"
      },
      {
        "from": "abstract",
        "to": "keep_detail",
        "when": "always"
      },
      {
        "from": "keep_detail",
        "to": "pair",
        "when": "always"
      },
      {
        "from": "pair",
        "to": "cues_index",
        "when": "always"
      }
    ],
    "fallbacks": {
      "abstract": "title-as-cue"
    }
  },
  {
    "id": "incremental-index",
    "name": "增量索引维护",
    "category": "maintain",
    "version": 2,
    "description": "监听库内变更，只对新增/变更对象重建 FTS 与向量，清理孤儿向量，保证索引与真源一致。",
    "trigger": {
      "kind": "schedule",
      "cron": "*/10 * * * *"
