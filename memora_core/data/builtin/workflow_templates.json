      },
      {
        "id": "decay",
        "name": "衰减打分",
        "kind": "fuse",
        "role": null,
        "params": {
          "algorithm": "exponential-decay",
          "half_life_days": 30,
          "archive_below": 0.1
        }
      },
      {
        "id": "archive",
        "name": "归档",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "archive"
        }
      },
      {
        "id": "purge",
        "name": "硬删除（需显式同意）",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "purge",
          "require": "explicit_consent",
          "audit": true
        }
      }
    ],
    "edges": [
      {
        "from": "candidates",
        "to": "decay",
        "when": "always"
      },
      {
        "from": "decay",
        "to": "archive",
        "when": "always"
      },
      {
        "from": "archive",
        "to": "purge",
        "when": "always"
      }
    ],
    "fallbacks": {
      "decay": "simple-age-rule"
    }
  },
