  {
    "id": "forget-decay",
    "name": "遗忘与衰减归档",
    "category": "maintain",
    "version": 3,
    "description": "按重要度、最近使用、复习稳定性计算衰减；低价值记忆归档而不删除；硬删除只在显式同意（explicit_consent=true + purge_ids）时执行并审计。",
    "trigger": {
      "kind": "schedule",
      "cron": "30 4 * * *"
    },
    "inputs": {
      "scope": "作用域",
      "explicit_consent": "硬删除同意（true 才会执行硬删除）",
