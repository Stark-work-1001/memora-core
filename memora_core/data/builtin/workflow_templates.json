      "centrality": "degree"
    }
  },
  {
    "id": "review-quiz-generate",
    "name": "复习题生成与批改",
    "category": "learn",
    "version": 3,
    "description": "基于已审核知识生成单选/填空/简答/推导题；带上作答（answers）再运行时批改并更新掌握度，驱动下一次复习间隔。",
    "trigger": {
      "kind": "manual",
      "sources": [
        "memory",
        "knowledge"
      ]
    },
    "inputs": {
      "topic": "主题或实体",
      "count": "题目数量",
      "answers": "作答列表（可选，按出题顺序）"
    },
    "nodes": [
      {
        "id": "select",
        "name": "选题素材",
        "kind": "retrieve",
        "role": null,
        "params": {
          "strategy": "coverage",
          "top_k": 8
        }
      },
      {
        "id": "generate",
        "name": "出题",
        "kind": "generate",
        "role": "chat",
        "params": {
          "types": [
            "single",
            "blank",
            "short",
            "derive"
          ]
        }
      },
      {
        "id": "validate",
        "name": "题目校验",
        "kind": "verify",
        "role": null,
        "params": {
          "rules": [
            "answerable",
            "no_leak",
            "not_trivial"
          ]
        }
      },
      {
        "id": "present",
        "name": "呈现",
        "kind": "emit",
        "role": null,
        "params": {
          "channel": "ui"
        }
      },
      {
        "id": "grade",
        "name": "批改",
        "kind": "judge",
        "role": "judge",
        "params": {
          "rubric": "grade"
        }
      },
      {
        "id": "update",
        "name": "更新掌握度",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "review_log"
        }
      }
    ],
    "edges": [
      {
        "from": "select",
        "to": "generate",
        "when": "always"
      },
      {
        "from": "generate",
        "to": "validate",
        "when": "always"
      },
      {
        "from": "validate",
        "to": "present",
        "when": "always"
      },
      {
        "from": "present",
        "to": "grade",
        "when": "always"
      },
      {
        "from": "grade",
        "to": "update",
        "when": "always"
      }
    ],
    "fallbacks": {
      "generate": "cloze-template",
      "grade": "string-similarity"
    }
  }
