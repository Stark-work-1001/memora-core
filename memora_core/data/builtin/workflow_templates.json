    "fallbacks": {
      "reindex_vec": "mark-degraded-keep-old"
    }
  },
  {
    "id": "dedup-merge",
    "name": "新记忆去重与合并",
    "category": "judge",
    "version": 4,
    "description": "新记忆入库前的核心闸门：近似召回旧记忆 → 打分分层（自动合并/进入判定/新建）→ 判定层给出 ADD/UPDATE/MERGE/SUPERSEDE/LINK/NOOP/ASK，并保留被合并来源。",
    "trigger": {
      "kind": "ingest",
      "sources": [
        "candidate"
      ]
    },
    "inputs": {
      "candidate": "候选记忆"
    },
    "nodes": [
      {
        "id": "candidate_in",
        "name": "候选接收",
        "kind": "input",
        "role": null,
        "params": {}
      },
      {
        "id": "near_dup",
        "name": "近似召回",
        "kind": "retrieve",
        "role": "embedding",
        "params": {
          "top_k": 10,
          "methods": [
            "cosine",
            "simhash",
            "jaccard"
          ]
        }
      },
      {
        "id": "band",
        "name": "分层打分",
        "kind": "fuse",
        "role": null,
        "params": {
          "bands": {
            "auto_merge": 0.92,
            "judge": 0.8,
            "new": 0.0
          }
        }
      },
      {
        "id": "judge",
        "name": "判定层裁决",
        "kind": "judge",
        "role": "judge",
        "params": {
          "actions": [
            "add",
            "update",
            "supersede",
            "merge",
            "link",
            "noop",
            "ask"
          ]
        }
      },
      {
        "id": "merge_write",
        "name": "合并写回",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "merge",
          "keep_sources": true,
          "keep_history": true
        }
      },
      {
        "id": "audit",
        "name": "审计留痕",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "audit",
          "table": "audit"
        }
      }
    ],
    "edges": [
      {
        "from": "candidate_in",
        "to": "near_dup",
        "when": "always"
      },
      {
        "from": "near_dup",
        "to": "band",
        "when": "always"
      },
      {
        "from": "band",
        "to": "judge",
        "when": "always"
      },
      {
        "from": "judge",
        "to": "merge_write",
        "when": "always"
      },
      {
        "from": "merge_write",
        "to": "audit",
        "when": "always"
      }
    ],
    "fallbacks": {
      "judge": "score-rule",
      "near_dup": "fts-near"
    }
  },
  {
    "id": "update-supersede",
    "name": "记忆更新与推翻",
    "category": "judge",
    "version": 3,
    "description": "处理迟到事实与版本演进：为新记忆设定生效时间，把旧记忆置为 superseded 并保留历史链，查询默认只返回当前有效版本。",
    "trigger": {
      "kind": "ingest",
      "sources": [
        "candidate"
      ]
    },
    "inputs": {
      "new_id": "推翻者条目 id（可选，须已批准）",
      "old_id": "被推翻条目 id（可选）",
      "candidate": "候选（可选：已入库条目 id，配合 target_id）",
      "valid_from": "生效时间"
    },
    "nodes": [
      {
        "id": "load_pair",
        "name": "加载新旧对",
        "kind": "input",
        "role": null,
        "params": {}
      },
      {
        "id": "temporal",
        "name": "时间关系判定",
        "kind": "judge",
        "role": "judge",
        "params": {
          "relations": [
            "before",
            "after",
            "overlap",
            "unknown"
          ]
        }
      },
      {
        "id": "supersede",
        "name": "标记推翻",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "supersede",
          "set_fields": [
            "valid_to",
            "superseded_by",
            "status"
          ]
        }
      },
      {
        "id": "history",
        "name": "历史链保留",
        "kind": "persist",
        "role": null,
        "params": {
          "op": "link",
          "rel": "supersedes"
        }
      },
      {
        "id": "notify",
        "name": "变更提示",
        "kind": "emit",
        "role": null,
        "params": {
          "channel": "review"
        }
      }
    ],
    "edges": [
      {
        "from": "load_pair",
        "to": "temporal",
        "when": "always"
      },
      {
        "from": "temporal",
        "to": "supersede",
        "when": "always"
      },
      {
        "from": "supersede",
        "to": "history",
        "when": "always"
      },
      {
        "from": "history",
        "to": "notify",
        "when": "always"
      }
    ],
    "fallbacks": {
      "temporal": "timestamp-order"
    }
  },
  {
